{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  // `scripts/**/*.ts` thêm 04/11/2026. Trước đó 10 script TypeScript — GỒM CẢ
  // `update-lesson-content.ts`, thứ AGENTS.md gọi là "đường nạp AN TOÀN" vào
  // DB production — chưa bao giờ đi qua `npm run typecheck`. Đo trước khi thêm:
  // **0 lỗi**, nên việc này miễn phí. Gieo thử một lỗi kiểu vào một script thì
  // typecheck phải ĐỎ; trước bản này nó im lặng xanh.
  "include": ["src/**/*", "test/**/*", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "frontend"]
}
