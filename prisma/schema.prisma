// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseLevel {
  beginner
  intermediate
  advanced

  @@map("course_level")
}

enum QuizStatus {
  generated
  submitted

  @@map("quiz_status")
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String?
  email                  String    @unique
  phone                  String?
  birthday               DateTime? @db.Date
  role                   String
  password               String    @db.VarChar(512)
  xp                     Int       @default(0)
  streak                 Int       @default(0)
  gems                   Int       @default(0)
  certificates           Int       @default(0)
  questionnaireCompleted Boolean   @default(false) @map("questionnaire_completed")
  lastStudyDate          DateTime? @map("last_study_date") @db.Date
  oauthProvider          String?   @map("oauth_provider")
  oauthProviderId        String?   @map("oauth_provider_id")
  avatar                 String?
  isVerified             Boolean   @default(false) @map("is_verified")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  authSessions        AuthSession[]
  emailVerifications  EmailVerification[]
  oauthAccounts       UserOauthAccount[]
  courses             Course[]
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  courseRatings       CourseRating[]
  missions            Mission[]
  quizzes             Quiz[]
  reviewQuizResults   ReviewQuizResult[]
  surveys             Survey[]
  roadmaps            RoadMap[]
  roadmapProgress     RoadMapProgress[]
  dailyXpLogs         UserDailyXpLog[]
  userBadges          UserBadge[]
  notificationSetting NotificationSetting?
  notifications       Notification[]
  comments            Comment[]
  posts               Post[]
  postReactions       PostReaction[]
  commentReactions    CommentReaction[]
  userAchievements    UserAchievement[]
  following           UserFollow[] @relation("UserFollowers")
  followers           UserFollow[] @relation("UserFollowing")
  learningEvents      LearningEvent[]
  logConsents         LearningEventConsent[]

  // Bảng xếp hạng ORDER BY xp/streak DESC LIMIT 20.
  // `map:` giữ đúng tên trong prisma/optional-indexes.sql để bản chạy tay
  // (CONCURRENTLY) và migration 20261012000000 là cùng một index.
  @@index([xp(sort: Desc)], map: "idx_users_xp_desc")
  @@index([streak(sort: Desc)], map: "idx_users_streak_desc")
  @@map("users")
}

model AuthSession {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  token      String
  // Chuỗi token sinh ra từ cùng một lần đăng nhập (xem RefreshTokenService).
  // Nullable: bản Django dùng chung bảng không biết cột này.
  familyId   String?   @map("family_id")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([token], map: "idx_auth_sessions_token")
  @@map("auth_sessions")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String
  type      String?
  expiresAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("email_verifications")
}

model UserOauthAccount {
  id             Int     @id @default(autoincrement())
  userId         Int     @map("user_id")
  provider       String?
  providerUserId String  @map("provider_user_id")

  user User @relation(fields: [userId], references: [id])

  @@map("user_oauth_accounts")
}

model Course {
  id           String       @id @default(cuid())
  title        String?
  level        CourseLevel?
  rating       Float        @db.Real
  lessonCount  Int          @map("lessons")
  instructorId Int          @map("instructor_id")
  xp_reward    Int
  isPublished  Boolean      @default(false) @map("is_published")
  contentMeta  Json?        @map("content_meta") @db.JsonB
  // Task 88: filter theo language + map accentColor ra response camelCase.
  language     String?
  accentColor  String?      @map("accent_color")

  user           User             @relation(fields: [instructorId], references: [id])
  lessons        Lesson[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  courseRatings  CourseRating[]
  missions       Mission[]
  quizzes        Quiz[]

  @@map("courses")
}

model Lesson {
  id               Int      @id @default(autoincrement())
  courseId         String   @map("course_id")
  lessonCode       String?  @map("lesson_code")
  module           String?
  title            String?
  subtitle         String?
  sortOrder        Int      @map("sort_order")
  contentJson      Json?    @map("content_json") @db.JsonB
  estimatedMinutes Int?     @map("estimated_minutes")
  xpReward         Int      @map("xp_reward")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course         Course           @relation(fields: [courseId], references: [id])
  lessonProgress LessonProgress[]

  @@unique([courseId, lessonCode])
  // Bản ghi tự tạo khi hoàn thành bài để lesson_code NULL, nên unique ở trên
  // không chặn được trùng (Postgres coi mọi NULL là khác nhau). Ràng buộc này
  // mới là thứ làm nhánh bắt P2002 trong LessonsService.resolveLesson() hoạt
  // động. Xem migration 20261012000000_critical_indexes_and_lesson_sort_unique.
  @@unique([courseId, sortOrder], map: "uq_lessons_course_sort")
  @@index([contentJson], type: Gin)
  @@map("lessons")
}

model Enrollment {
  userId           Int      @map("user_id")
  courseId         String   @map("course_id")
  progress         Int
  completedLessons Int      @map("completed_lessons")
  status           String?
  // Lưu dạng chuỗi '12.5h' theo bản Django -> StatsService.parseTimeSpent() parse ra số.
  timeSpent        String?  @map("time_spent")
  enrolledAt       DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  userId      Int      @map("user_id")
  lessonId    Int      @map("lesson_id")
  courseId    String   @map("course_id")
  status      String?
  quizScore   Int      @map("quiz_score")
  xpEarned    Int      @map("xp_earned")
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
  // PK (user_id, lesson_id) không phủ được course_id — tính lại tiến độ khi
  // enroll/complete lọc theo cặp (user_id, course_id).
  @@index([userId, courseId], map: "idx_lesson_progress_user_course")
  @@map("lesson_progress")
}

// Nhật ký LẦN THỬ — phụ lục theo thời gian cho những gì `lesson_progress` không
// ghi được. Chi tiết lý do từng cột nằm trong
// prisma/migrations/20261028000000_learning_events/migration.sql; phần phải nhớ
// khi sửa model này:
//
//  · `id` là Int (SERIAL) có chủ đích — BigInt làm `JSON.stringify` NÉM khi có
//    route nào đọc lại bảng này.
//  · KHÔNG có `lessonId` và KHÔNG có quan hệ tới `Lesson`/`Course`: bài tra theo
//    `(courseId, lessonNo)` như cả hệ thống, còn khoá ngoại tới `lessons` sẽ làm
//    MỘT sự kiện mang mã bài rác giết cả LÔ `createMany`.
//  · `payload` đã được cắt trần ở `learning-events.sanitize.ts` trước khi tới
//    đây. Mã nguồn của người học KHÔNG BAO GIỜ nằm trong này — kể cả dưới dạng
//    hash (`code` và `codeHash` đều trong `KHOA_CAM_PAYLOAD`). Bảng giữ KẾT
//    LUẬN `sameAsPrev`/`repeatStreak`, không giữ dấu vân tay.
//  · HẠN LƯU 90 NGÀY (`HAN_LUU_NGAY`). Câu `DELETE` nằm ở cuối
//    `scripts/learning-events/truy-van.sql`; không có job tự xoá, có chủ đích.
//  · Lớp này chỉ phát ra sự kiện SAU khi người học đồng ý — cổng đồng ý nằm ở
//    `frontend/src/lib/learning-events.ts`, mặc định TẮT.
model LearningEvent {
  id         Int       @id @default(autoincrement())
  /// UUID v4 do CLIENT sinh cho TỪNG sự kiện — khoá chống trùng. Một lô gửi
  /// lúc trang ẩn có thể TỚI máy chủ mà phản hồi không về kịp, nên client gửi
  /// lại; `@unique` + `skipDuplicates` làm lần hai thành no-op, và `createMany`
  /// trả về số hàng THẬT SỰ chèn nên tỉ lệ trùng là số đo miễn phí.
  eventId    String    @unique(map: "uq_learning_events_event_id") @map("event_id")
  userId     Int       @map("user_id")
  courseId   String?   @map("course_id")
  /// `lessons.sort_order` của bài, không phải `lessons.id` — khoá mà cả hệ
  /// thống dùng, và là thứ câu SQL drop-off cần để xếp thứ bậc bài.
  lessonNo   Int?      @map("lesson_no")
  /// `LessonScreen.key` của màn đang mở (vd `s2-mcq-0`) — chỗ duy nhất nói được
  /// "họ bỏ dở ở MÀN nào", không chỉ "ở bài nào".
  screenKey  String?   @map("screen_key")
  kind       String
  payload    Json?     @db.JsonB
  /// BA dấu thời gian, không phải hai (mẫu Snowplow `dtm`/`stm`/collector):
  /// `clientAt` = thiết bị TẠO sự kiện, `clientSentAt` = thiết bị GỬI lô,
  /// `createdAt` = máy chủ NHẬN. Hai mốc đầu cùng một đồng hồ nên HIỆU của
  /// chúng đúng dù giờ máy sai; mốc dùng để so GIỮA người học là mốc suy ra
  /// `createdAt - (clientSentAt - clientAt)`, không phải `clientAt`.
  clientAt     DateTime? @map("client_at") @db.Timestamptz(6)
  clientSentAt DateTime? @map("client_sent_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ba index phục vụ đúng ba câu trong scripts/learning-events/truy-van.sql.
  // `kind` đứng đầu vì heartbeat là loại đông nhất: lọc nó ra trước là bỏ được
  // phần lớn bảng.
  @@index([kind, courseId, lessonNo], map: "idx_learning_events_kind_lesson")
  @@index([userId, courseId, lessonNo, kind], map: "idx_learning_events_user_lesson")
  @@index([createdAt(sort: Desc)], map: "idx_learning_events_created")
  @@map("learning_events")
}

/// SỰ ĐỒNG Ý cho lớp ghi nhật ký. Bảng CHỈ THÊM HÀNG (append-only): một hàng cho
/// mỗi lần người học quyết, kể cả lần RÚT LẠI (`granted = false`). Trạng thái
/// hiện tại là hàng MỚI NHẤT theo `created_at`.
///
/// Vì sao append-only chứ không một cột trên `users`: phải chứng minh được cả
/// việc rút lại, và một cột bị ghi đè thì lịch sử đó không còn. Luật về dữ liệu
/// nhạy cảm đòi chứng minh được sự đồng ý, mà một giá trị hiện tại không chứng
/// minh được nó có từ lúc nào.
///
/// `version` là thứ làm cho "đã đồng ý" không tự động nghĩa là "đồng ý điều
/// này" — xem `learning-event-consent.ts`. Không có nó thì mở rộng phạm vi thu
/// thập sẽ chạy dưới sự đồng ý cũ mà không ai biết.
model LearningEventConsent {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")

  /// `true` = đồng ý, `false` = từ chối HOẶC rút lại. Một cột boolean chứ không
  /// hai loại hàng riêng: "từ chối" và "rút lại" là cùng một kết quả (không
  /// được ghi), và phân biệt chúng được bằng việc có hàng `true` nào trước đó.
  granted Boolean

  /// Phiên bản bản mô tả mà người học đồng ý với (`PHIEN_BAN_DONG_Y`). Lưu lại
  /// chứ không suy ra: sáu tháng sau, biết hàng này ứng với bản mô tả nào là
  /// toàn bộ giá trị của nó.
  version String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Đọc trạng thái hiện tại là `WHERE user_id = ? ORDER BY created_at DESC
  /// LIMIT 1`, và nó chạy MỘT LẦN mỗi lô sự kiện — nên index phải phủ đúng hình
  /// dạng đó, không chỉ `user_id`.
  @@index([userId, createdAt(sort: Desc)], map: "idx_log_consents_user_created")
  @@map("learning_event_consents")
}

model CourseRating {
  userId    Int      @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
  @@map("course_ratings")
}

model Mission {
  userId           Int     @map("user_id")
  courseId         String  @map("course_id")
  title            String?
  xpReward         Int     @map("xp_reward")
  correctCondition String? @map("correct_condition")
  isActive         Boolean @default(false) @map("is_active")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
  @@map("missions")
}

model Quiz {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  courseId      String      @map("course_id")
  status        QuizStatus? @default(generated)
  /// Loại đề. NULL = đề ôn tập thường (mọi bản ghi có trước cột này, và mọi
  /// đề do `generateQuiz`/`generateReviewQuiz`/`generateTodayQuiz` phát).
  /// `'post_test'` = BÀI HẬU KIỂM CÓ TRỄ, thứ chỉ được phát MỘT LẦN cho mỗi
  /// học viên mỗi khoá — và cột này là chỗ duy nhất trả lời được câu "đã phát
  /// chưa". Là chuỗi tự do chứ KHÔNG phải enum: thêm giá trị vào một enum
  /// Postgres đang dùng chung với bản Django là đổi kiểu, mà luật của repo chỉ
  /// cho THÊM cột nullable / thêm index.
  kind          String?     @map("kind")
  questionsJson Json        @map("questions_json") @db.JsonB
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewQuizResults ReviewQuizResult[]

  @@index([userId, courseId])
  @@index([status])
  // Cổng một-lần của bài hậu kiểm tra đúng ba cột này mỗi lần người học mở
  // trang; không có index là quét bảng quizzes (phình theo mọi lượt ôn tập).
  @@index([userId, courseId, kind], map: "idx_quizzes_user_course_kind")
  @@map("quizzes")
}

model ReviewQuizResult {
  id          Int      @id @default(autoincrement())
  quizId      Int      @map("quiz_id")
  userId      Int      @map("user_id")
  score       Int
  total       Int
  answersJson Json     @map("answers_json") @db.JsonB
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@map("review_quiz_results")
}

model Survey {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  dataJson  Json     @map("data_json") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id])
  roadmaps RoadMap[]

  @@map("surveys")
}

model RoadMap {
  id                    String   @id @default(cuid())
  userId                Int      @map("user_id")
  generatedFromSurveyId Int      @map("generated_from_survey_id")
  source                String?
  title                 String?  @map("title")
  nodesJson             Json     @map("nodes_json") @db.JsonB
  edgesJson             Json     @map("edges_json") @db.JsonB
  mermaidDef            String?  @map("mermaid_def")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User              @relation(fields: [userId], references: [id])
  survey          Survey            @relation(fields: [generatedFromSurveyId], references: [id])
  roadmapProgress RoadMapProgress[]

  @@map("roadmaps")
}

model RoadMapProgress {
  userId      Int      @map("user_id")
  roadmapId   String   @map("roadmap_id")
  itemId      String   @map("item_id")
  done        Boolean  @default(false)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  roadmap RoadMap @relation(fields: [roadmapId], references: [id])

  @@id([userId, roadmapId, itemId])
  @@map("roadmap_progress")
}

model Questionnaire {
  id            Int     @id @default(autoincrement())
  version       Int
  title         String?
  questionsJson Json    @map("questions_json") @db.JsonB
  isActive      Boolean @default(false) @map("is_active")

  @@map("questionnaires")
}

model UserDailyXpLog {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  logDate  DateTime @map("log_date") @db.Date
  xpEarned Int      @map("xp_earned")

  user User @relation(fields: [userId], references: [id])

  // Leaderboard tuần: SUM(xp_earned) theo (user_id, khoảng log_date).
  @@index([userId, logDate], map: "idx_daily_xp_user_date")
  @@map("user_daily_xp_logs")
}

model Badge {
  id             Int     @id @default(autoincrement())
  code           String? @unique
  name           String?
  conditionType  String? @map("condition_type")
  conditionValue Int     @map("condition_value")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    Int      @map("user_id")
  badgeId   Int      @map("badge_id")
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@id([userId, badgeId])
  @@map("user_badges")
}

model NotificationSetting {
  userId        Int     @map("user_id")
  emailNotif    Boolean @map("email_notif")
  pushNotif     Boolean @map("push_notif")
  studyRemind   Boolean @map("study_remind")
  contentUpdate Boolean @map("content_update")

  user User @relation(fields: [userId], references: [id])

  @@id([userId])
  @@map("notification_settings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String?
  title     String?
  body      String?
  refType   String?  @map("ref_type")
  refId     Int      @map("ref_id")
  isRead    Boolean  @default(false) @map("is_read")
  // Task 199-201: gộp thông báo cùng (type, ref_type, ref_id) chưa đọc trong 10 phút.
  coalesceCount Int  @default(1) @map("coalesce_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  // /api/notifications/badge bị client poll ~45s/lần và không rate-limit.
  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notifications_user_read_created")
  @@map("notifications")
}

model Post {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  category  String?
  title     String?
  content   String?
  likeCount Int      @map("like_count")
  createdAt DateTime @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id])
  comments  Comment[]
  reactions PostReaction[]

  @@map("posts")
}

model Comment {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  postId          Int      @map("post_id")
  parentCommentId Int?     @map("parent_comment_id")
  content         String?
  createdAt       DateTime @default(now()) @map("created_at")

  user      User              @relation(fields: [userId], references: [id])
  post      Post              @relation(fields: [postId], references: [id])
  parent    Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  // Phân trang bình luận gốc (parent_comment_id IS NULL) và nạp reply theo bài.
  @@index([postId, parentCommentId, createdAt], map: "idx_comments_post_parent_created")
  @@map("comments")
}

// Task 163 — tên model theo task sheet (PostReaction), tên bảng theo Sheet 3 (post_likes).
// Cột `type` giữ 1 trong 6 loại reaction; mặc định 'like' cho dữ liệu cũ.
model PostReaction {
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  type      String   @default("like")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@id([userId, postId])
  @@map("post_likes")
}

// Task 164 — bảng comment_likes (Sheet 3), chưa từng tồn tại trong DB.
model CommentReaction {
  userId    Int      @map("user_id")
  commentId Int      @map("comment_id")
  type      String   @default("like")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])

  @@id([commentId, userId])
  @@map("comment_likes")
}

// Task 148-149 — achievements/user_achievements (Sheet 3 liệt kê composite key
// user_achievements(user_id, achievement_id)). Tách riêng khỏi badges/user_badges.
model Achievement {
  id             Int     @id @default(autoincrement())
  code           String? @unique
  name           String?
  description    String?
  icon           String?
  conditionType  String? @map("condition_type")
  conditionValue Int     @default(0) @map("condition_value")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        Int      @map("user_id")
  achievementId Int      @map("achievement_id")
  awardedAt     DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model UserFollow {
  followerId Int      @map("follower_id")
  followeeId Int      @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower User @relation("UserFollowers", fields: [followerId], references: [id])
  followee User @relation("UserFollowing", fields: [followeeId], references: [id])

  @@id([followerId, followeeId])
  @@map("user_follows")
}
