# Cấu hình runner — chép thành .env (KHÔNG commit). Nạp bằng `node --env-file=.env`.

# BẮT BUỘC, >= 32 ký tự, phải TRÙNG RUNNER_SECRET của backend.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNNER_SECRET=

# Địa chỉ lắng nghe. Mặc định chỉ nhận kết nối từ chính máy này: Caddy đứng trước
# làm HTTPS rồi chuyển vào đây. KHÔNG đặt 0.0.0.0 trừ khi bạn biết vì sao.
HOST=127.0.0.1
PORT=8080

# Image sandbox (build từ docker/py-sandbox/Dockerfile)
PY_SANDBOX_IMAGE=py-sandbox
# Hết giờ thì giết container (ms)
PY_RUN_TIMEOUT_MS=10000
# Số bài chạy SONG SONG. Mỗi bài được 1 CPU và PY_RUN_MEMORY RAM nên đặt theo số nhân CPU của VM
# (VM 4 nhân, 8 GB RAM: PY_RUN_MAX_CONCURRENT=4, PY_RUN_MEMORY=1.5g). Runner TỪ CHỐI KHỞI ĐỘNG nếu
#   PY_RUN_MAX_CONCURRENT × PY_RUN_MEMORY + 1.5 GB > RAM của máy chạy Docker (docker info),
# và chỉ cảnh báo nếu PY_RUN_MAX_CONCURRENT > 1.5 × số nhân.
PY_RUN_MAX_CONCURRENT=1
# RAM mỗi bài, dùng cho cả --memory và --memory-swap. Nhận 1g, 1.5g, 1536m (bắt buộc có đơn vị m/g).
PY_RUN_MEMORY=1g
# Phần vượt PY_RUN_MAX_CONCURRENT thì XẾP HÀNG (ai đến trước chạy trước) thay vì bị từ chối.
# Hàng đầy → 429 ngay "Máy chủ đang quá tải, thử lại sau".
PY_RUN_QUEUE_MAX=100
# Chờ quá lâu chưa tới lượt → rút khỏi hàng, 429 cùng thông điệp (ms).
# Đặt GIỐNG PY_RUN_QUEUE_TIMEOUT_MS của backend: backend chờ runner = giá trị này + PY_RUN_TIMEOUT_MS + 10 giây.
PY_RUN_QUEUE_TIMEOUT_MS=30000
