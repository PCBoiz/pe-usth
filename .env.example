# Pooled — dùng cho app (NestJS runtime)
DATABASE_URL=""

# Direct — dùng cho Prisma CLI (migrate/push)
DIRECT_URL=""

#JWT
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES=""
JWT_REFRESH_EXPIRES=""

# Hạn refresh token của TÀI KHOẢN KHÁCH (@guest.local), mặc định 30d.
# Tách khỏi JWT_REFRESH_EXPIRES vì đợt thử nghiệm cố ý không bắt đăng nhập:
# với người thử, refresh token CHÍNH LÀ thứ duy nhất giữ tiến độ — hết hạn là
# `apiFetch` rơi xuống /auth/guest và cấp tài khoản mới, họ thấy như mất sạch.
# Không nâng JWT_REFRESH_EXPIRES lên cho gọn: làm vậy là nới cửa sổ dùng được
# của một cookie bị đánh cắp cho đúng những tài khoản CÓ GÌ ĐỂ MẤT (quản trị
# viên, tài khoản từ bản Django). Khách thì không mật khẩu, không thông tin cá
# nhân, chỉ có tiến độ bài học.
JWT_GUEST_REFRESH_EXPIRES="30d"

# Bài hậu kiểm có trễ: một bài học chỉ được hỏi lại sau bao nhiêu NGÀY kể từ
# lúc hoàn thành. 7 là quy ước (ngưỡng CÓ bằng chứng chỉ là ">= 1 ngày"); trần
# là 30 vì phiên khách sống 30 ngày theo JWT_GUEST_REFRESH_EXPIRES — trễ dài
# hơn hạn phiên thì người thử nhận userId mới và không ghép được hậu kiểm với
# tiền kiểm. Đặt 0 để tắt cổng trễ khi thử tay — đừng để TRỐNG, chuỗi rỗng bị
# Joi từ chối và app không khởi động (đúng chủ ý: trống mà hiểu thành 0 là mở
# toang cổng mà không ai thấy).
POSTTEST_DELAY_DAYS="7"

#Frontend/CORS
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Cookie httpOnly chứa refresh token. lax: frontend & backend cùng site
# (localhost:3000 + localhost:5000, hoặc app.x.com + api.x.com).
# none: khác site (vd *.vercel.app + *.onrender.com) — bắt buộc HTTPS, và
# Safari chặn cookie bên thứ ba nên nên đưa hai bên về cùng domain.
REFRESH_COOKIE_SAMESITE="lax"

# Số reverse proxy đứng trước app (Render/Railway/nginx = 1). 0 khi chạy trực tiếp.
TRUST_PROXY_HOPS="0"

#OAUTH google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

#OAUTH facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET="" 

# Chatbot Gemini (https://aistudio.google.com/apikey)
# Để trống = tắt trợ lý AI (route /api/chatbot/message trả 503), app vẫn chạy.
GEMINI_API_KEY=""
# Các biến dưới đây tuỳ chọn, bỏ trống là dùng mặc định trong src/config/gemini.config.ts
GEMINI_MODEL="gemini-2.5-flash"
# Số lượt chat tối đa mỗi người dùng trong 1 giờ
GEMINI_HOUR_LIMIT="60"

# (Đã bỏ 25/10/2026) LESSON_CACHE_TTL_MS / LESSON_CACHE_DISABLED từng được ghi ở đây kèm lời
# hứa "giảm một truy vấn nặng (~550 ms) mỗi lần mở bài" — nhưng KHÔNG mã nào đọc chúng, và
# `git log -S` trên src/ không có một commit nào: bộ cache đó chưa bao giờ được làm. Đặt chúng
# trên Render là không có tác dụng gì.
#
# Thay vào đó, đường nóng của GET /courses/:id/lessons/:n/content đã được rút từ BA vòng DB
# tuần tự xuống HAI vòng song song (đo trên DB thật: 150 ms -> 99 ms). Xem chú thích trong
# src/lessons/lessons.service.ts; ở đó cũng ghi lại rằng $transaction làm CHẬM HƠN (251 ms).
# Log thời gian từng truy vấn của GET /api/courses/:id/lessons/:n/bundle (để trống: bật ngoài production).
LESSON_BUNDLE_TIMING=
