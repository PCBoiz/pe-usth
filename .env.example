# Pooled — dùng cho app (NestJS runtime)
DATABASE_URL=""

# Direct — dùng cho Prisma CLI (migrate/push)
DIRECT_URL=""

#JWT
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES=""
JWT_REFRESH_EXPIRES=""

#Frontend/CORS 
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Cookie httpOnly chứa refresh token. lax: frontend & backend cùng site
# (localhost:3000 + localhost:5000, hoặc app.x.com + api.x.com).
# none: khác site (vd *.vercel.app + *.onrender.com) — bắt buộc HTTPS, và
# Safari chặn cookie bên thứ ba nên nên đưa hai bên về cùng domain.
REFRESH_COOKIE_SAMESITE="lax"

# Số reverse proxy đứng trước app (Render/Railway/nginx = 1). 0 khi chạy trực tiếp.
TRUST_PROXY_HOPS="0"

#OAUTH google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

#OAUTH facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET="" 

# Chatbot Gemini (https://aistudio.google.com/apikey)
# Để trống = tắt trợ lý AI (route /api/chatbot/message trả 503), app vẫn chạy.
GEMINI_API_KEY=""
# Các biến dưới đây tuỳ chọn, bỏ trống là dùng mặc định trong src/config/gemini.config.ts
GEMINI_MODEL="gemini-2.5-flash"
# Số lượt chat tối đa mỗi người dùng trong 1 giờ
GEMINI_HOUR_LIMIT="60"

# Python IDE (POST /api/python/run) — chạy mã trong container Docker dùng một lần.
# Cần Docker và image sandbox đã build sẵn (python:3.12-slim + numpy/pandas/psutil, user không phải root).
PY_SANDBOX_IMAGE=py-sandbox
# Hết giờ thì giết container (ms)
PY_RUN_TIMEOUT_MS=10000
# Số container chạy đồng thời tối đa. Vượt thì XẾP HÀNG (FIFO) rồi mới 429 khi hàng đầy.
# CHỈ áp khi PY_RUNNER_MODE=local — ở chế độ remote, runner tự quyết (xem runner/.env).
PY_RUN_MAX_CONCURRENT=2
# Số bài tối đa được xếp hàng chờ; hàng đầy thì 429 "Máy chủ đang quá tải, thử lại sau".
PY_RUN_QUEUE_MAX=100
# Chờ quá lâu chưa tới lượt thì rút khỏi hàng và 429 (ms). Ở chế độ remote PHẢI bằng giá trị
# của runner: backend chờ runner = PY_RUN_QUEUE_TIMEOUT_MS + PY_RUN_TIMEOUT_MS + 10 giây.
PY_RUN_QUEUE_TIMEOUT_MS=30000
# RAM mỗi bài, dùng cho cả --memory và --memory-swap: 1g, 1.5g, 1536m (cần đơn vị m hoặc g).
PY_RUN_MEMORY=1g
# true → route chạy mã KHÔNG đòi đăng nhập (mặc định false: vẫn đòi JWT).
# Khi bật, hãy giới hạn bằng lớp mạng (IP allowlist / basic auth ở reverse proxy)
# và đặt TRUST_PROXY_HOPS để throttle tính theo IP thật, không theo IP của proxy.
PY_RUNNER_PUBLIC=false

# Nơi chạy mã Python: local = Docker ngay trên máy này | remote = gọi runner HTTP ở máy khác
# (Render không có Docker nên phải dùng remote — xem runner/README.md).
PY_RUNNER_MODE=local
# Chỉ cần khi PY_RUNNER_MODE=remote (bắt buộc cả hai; RUNNER_SECRET >= 32 ký tự,
# phải TRÙNG RUNNER_SECRET đặt ở runner). Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNNER_URL=
RUNNER_SECRET=

# Cache nội dung bài học trong bộ nhớ backend: giảm một truy vấn nặng (~550 ms) mỗi lần mở bài.
# Admin nhập/sửa/xoá bài qua API thì cache tự xoá; script seed chạy ngoài backend chỉ có hiệu lực
# sau tối đa TTL hoặc khi khởi động lại backend. 0 hoặc LESSON_CACHE_DISABLED=true để tắt.
LESSON_CACHE_TTL_MS=600000
LESSON_CACHE_DISABLED=false
# Log thời gian từng truy vấn của GET /api/courses/:id/lessons/:n/bundle (để trống: bật ngoài production).
LESSON_BUNDLE_TIMING=
