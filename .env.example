# Pooled — dùng cho app (NestJS runtime)
DATABASE_URL=""

# Direct — dùng cho Prisma CLI (migrate/push)
DIRECT_URL=""

#JWT
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES=""
JWT_REFRESH_EXPIRES=""

#Frontend/CORS 
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Cookie httpOnly chứa refresh token. lax: frontend & backend cùng site
# (localhost:3000 + localhost:5000, hoặc app.x.com + api.x.com).
# none: khác site (vd *.vercel.app + *.onrender.com) — bắt buộc HTTPS, và
# Safari chặn cookie bên thứ ba nên nên đưa hai bên về cùng domain.
REFRESH_COOKIE_SAMESITE="lax"

# Số reverse proxy đứng trước app (Render/Railway/nginx = 1). 0 khi chạy trực tiếp.
TRUST_PROXY_HOPS="0"

#OAUTH google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

#OAUTH facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET="" 

# Chatbot Gemini (https://aistudio.google.com/apikey)
# Để trống = tắt trợ lý AI (route /api/chatbot/message trả 503), app vẫn chạy.
GEMINI_API_KEY=""
# Các biến dưới đây tuỳ chọn, bỏ trống là dùng mặc định trong src/config/gemini.config.ts
GEMINI_MODEL="gemini-2.5-flash"
# Số lượt chat tối đa mỗi người dùng trong 1 giờ
GEMINI_HOUR_LIMIT="60"
